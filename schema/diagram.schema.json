{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VoidingWarranties/esp-spice/schema/diagram.schema.json",
  "title": "diagram.json",
  "description": "A circuit in the Wokwi diagram format. See docs/circuit-format.md.",
  "type": "object",
  "required": ["version", "parts", "connections"],
  "properties": {
    "version": { "const": 1 },
    "author": { "type": "string" },
    "editor": { "type": "string" },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "top": { "type": "number" },
        "left": { "type": "number" },
        "rotate": { "type": "number" },
        "hide": { "type": "boolean" },
        "attrs": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "pinRef": {
      "type": "string",
      "pattern": "^[^:]+:.+$"
    },
    "connection": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/pinRef" },
        { "$ref": "#/$defs/pinRef" },
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "minItems": 2,
      "maxItems": 4
    }
  }
}
